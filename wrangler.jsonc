{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "labelcroptools",
  "compatibility_date": "2026-09-23",

  // Pure static site: no `main`, so no Worker script runs and no ASSETS binding
  // is needed. Cloudflare serves dist/ straight from the edge.
  "assets": {
    "directory": "./dist/",
    // Serve the nearest 404.html (with a 404 status) for unmatched paths.
    // Workers requires this to be explicit — unlike Pages, it does not guess.
    "not_found_handling": "404-page",
    // Pages are emitted as <slug>/index.html and linked as /<slug>/, which is
    // exactly what auto-trailing-slash serves. Stated rather than left to the
    // default so a future default change cannot silently alter canonical URLs.
    "html_handling": "auto-trailing-slash"
  },

  // No *.workers.dev hostname. The site would otherwise be reachable at a second
  // address, which Google can index as duplicate content.
  "workers_dev": false,

  "routes": [
    { "pattern": "labelcroptools.com", "custom_domain": true }
  ],

  "observability": { "enabled": true }
}
