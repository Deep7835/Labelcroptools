{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "www-redirect",
  "main": "index.js",
  "compatibility_date": "2026-09-23",
  // No *.workers.dev address: this Worker exists only to answer the www hostname.
  "workers_dev": false,
  "routes": [
    { "pattern": "www.labelcroptools.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
